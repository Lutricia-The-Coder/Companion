{
  "name": "companion-safety",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-speech-recognition": "58.0.0",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "firebase-tools": "^15.34.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test tests/safetyDecisionEngine.test.mjs",
    "test:audio-evaluation": "node --test tests/audioEvaluation.test.mjs",
    "test:supabase-email": "node --experimental-strip-types --test tests/supabaseEmailNotifications.test.mjs",
    "test:functions": "node --test functions/emergencyActivation.test.js functions/notificationRetry.test.js",
    "test:firebase": "firebase emulators:exec --project demo-companion-safety --only database,storage --non-interactive \"node --test tests/firebaseRules.integration.test.mjs\"",
    "test:firebase:callables": "firebase emulators:exec --project demo-companion-safety --only auth,database,functions --non-interactive \"node --test tests/firebaseCallables.integration.test.mjs\"",
    "test:firebase:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-firebase-emulators.ps1"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "modules"
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-companion-monitor"
        ]
      }
    }
  }
}
