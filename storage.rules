rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{uid}/{journeyId}/{eventId}/{fileName} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('^(audio/mp4|audio/m4a|video/mp4)$');
    }
  }
}
