-- One-time setup in the Supabase SQL Editor after enabling the pg_cron and pg_net extensions.
-- Replace both placeholders locally. Do not commit a filled-in copy: the service role key is secret.
select vault.create_secret('https://YOUR_PROJECT_REF.supabase.co', 'companion_project_url');
select vault.create_secret('YOUR_SERVICE_ROLE_KEY', 'companion_service_role_key');

select cron.schedule(
  'companion-cleanup-expired-evidence',
  '30 2 * * *', -- daily at 02:30 UTC
  $$
    select net.http_post(
      url := (select decrypted_secret from vault.decrypted_secrets where name = 'companion_project_url') || '/functions/v1/cleanup-expired-evidence',
      headers := jsonb_build_object(
        'Content-Type', 'application/json',
        'apikey', (select decrypted_secret from vault.decrypted_secrets where name = 'companion_service_role_key'),
        'Authorization', 'Bearer ' || (select decrypted_secret from vault.decrypted_secrets where name = 'companion_service_role_key')
      ),
      body := '{}'::jsonb,
      timeout_milliseconds := 30000
    );
  $$
);
